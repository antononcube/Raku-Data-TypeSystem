# use lib <. lib>;

use Data::TypeSystem;
use Data::TypeSystem::Predicates;

use Test;

my @a = [[1, 2], [3, 4]];
my @b = [[1, 2], [3]];
my @c = [ [[1, 2], [3, 4]], [[13, 14], [41, 42]] ];
my @d = [ [[1, 2], [3, 4]], [[13, 14, 15], [41, 42, 43]] ];

plan *;

## 1
is is-full-array(@a), True;

## 2
is is-full-array(@b), False;

## 3
is is-full-array(@c), True;

## 4
is is-full-array(@d), False;

## 5
is is-full-array(@a, 2), True;

## 6
is is-full-array(@a, 3), False;

## 7
is is-full-array(@a, 1..3), True;

## 8
is is-full-array(@a, 1..3, Int), True;

## 9
is is-full-array(@a, 1..3, Str), False;

done-testing;
